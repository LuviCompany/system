# === LUVI CRM — variáveis de ambiente ===
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o arquivo ".env" (ele já está no .gitignore).

# --- Banco de dados ---
# String de conexão do PostgreSQL. Exemplo local:
# DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/luvi_crm?schema=public"
DATABASE_URL=""

# --- Autenticação ---
# Segredo usado para assinar os tokens de sessão (JWT). Gere um valor aleatório forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Aquisição de leads: Google Places API (New) ---
# Chave de API do Google Cloud com a "Places API (New)" habilitada e
# faturamento ativo. Usada SOMENTE no servidor (src/server/lead-sourcing/
# google-places) — nunca é enviada ao navegador. Sem esta variável, /encontrar-leads
# continua funcionando normalmente em modo demonstração (provider mock).
# Gere em: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=""

# --- Criptografia de tokens em repouso (etapa 5 — integrações reais) ---
# Chave usada para criptografar (AES-256-GCM) os tokens OAuth guardados no
# banco (ex: access/refresh token do Google Ads). Precisa ter exatamente 32
# bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave invalida todas as conexões já salvas (será necessário
# reconectar cada integração). Ver src/server/security/token-crypto.ts.
TOKEN_ENCRYPTION_KEY=""

# --- Integração real: Google Ads (etapa 5) ---
# Client ID e Client Secret de um OAuth Client (tipo "Web application") no
# Google Cloud Console. Nunca expor o Client Secret no frontend.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Developer Token da conta de gerente (MCC) do Google Ads usada para acessar
# a API. Precisa estar em nível "Basic" ou "Standard" para acessar contas
# reais (o nível "Test" só acessa contas de teste do Google Ads).
GOOGLE_ADS_DEVELOPER_TOKEN=""
# URL de callback OAuth cadastrada no Google Cloud Console, ex:
#   http://localhost:3000/api/integrations/google-ads/callback (dev)
#   https://SEU-DOMINIO/api/integrations/google-ads/callback (produção)
GOOGLE_REDIRECT_URI=""

# --- Integração real: Meta Ads / Instagram (etapa 6) ---
# App ID e App Secret de um app Meta (Facebook Login for Business) criado em
# https://developers.facebook.com/apps — nunca expor o App Secret no frontend.
# Sem estas três variáveis, isMetaConfigured() retorna false e os cards de
# Meta Ads/Instagram em /clientes/[id]/integracoes ficam em "não configurado"
# (ver src/server/integrations/meta/config.ts).
META_APP_ID=""
META_APP_SECRET=""
# URL de callback OAuth cadastrada no app Meta, ex:
#   http://localhost:3000/api/integrations/meta/callback (dev)
#   https://SEU-DOMINIO/api/integrations/meta/callback (produção)
META_REDIRECT_URI=""
